size 120 40
cursor 0 0 hidden
text 0 "                     ┌ Help ──────────────────────────────────────────────────────────────────────┐"
style 0 22 28 bold
text 1 "  ┌ Arko ────────────│                                                                            │──────────────────┐"
style 1 2 3 dim
style 1 3 9 bold
style 1 9 21 dim
style 1 99 118 dim
text 2 "  │ Model      gpt-6-│  Ctrl+B        move the agent's running call to the background, else back  │                  │"
style 2 2 15 dim
style 2 23 31 reverse
style 2 116 118 dim
text 3 "  │ Workers    parall│                a character                                                 │                  │"
style 3 2 15 dim
style 3 116 118 dim
text 4 "  │ Workspace  /home/│  Ctrl+O        the next view (full, quiet, messages)                       │                  │"
style 4 2 15 dim
style 4 23 31 reverse
style 4 116 118 dim
text 5 "  │ Session    202611│  Ctrl+G        the transcript's rows that open, where ↑ ↓ move and Enter   │                  │"
style 5 2 15 dim
style 5 23 31 reverse
style 5 116 118 dim
text 6 "  │ Project    AGENTS│                opens or closes one                                         │                  │"
style 6 2 15 dim
style 6 116 118 dim
text 7 "  │ Tools      2 skil│  Ctrl+R        dictate into the box, and again to stop and edit the words  │                  │"
style 7 2 15 dim
style 7 23 31 reverse
style 7 116 118 dim
text 8 "  └──────────────────│                (Enter stops too, Esc takes them out)                       │──────────────────┘"
style 8 2 21 dim
style 8 99 118 dim
text 9 "                     │  Ctrl+T        the agent list, where Tab and Shift+Tab move through it and │"
style 9 23 31 reverse
text 10 "▎ Add a README with a│                Enter shows a worker's own work                             │"
style 10 0 2 fg=cyan
text 11 "                     │  Alt+Q         open the answer panel for the agent's questions             │"
style 11 23 30 reverse
text 12 "  Done. The README ha│  Alt+A         the approval tray, where Space selects, Enter approves the  │"
style 12 23 30 reverse
text 13 "                     │                selection, R rejects all, V opens a row's details and M     │"
text 14 "                     │                flips Include message                                       │"
text 15 "                     │  Esc           close, go back, or leave the answer panel to answer in a    │"
style 15 23 28 reverse
text 16 "                     │                message                                                     │"
text 17 "                     │  Ctrl+C        stop the turn, else clear the box                           │"
style 17 23 31 reverse
text 18 "                     │  Ctrl+D        quit, when the box is empty (as /exit)                      │"
style 18 23 31 reverse
text 19 "                     │  Ctrl+L        draw the screen again                                       │"
style 19 23 31 reverse
text 20 "                     │  Drag          select text, and it is copied when you let go               │"
style 20 23 29 reverse
text 21 "                     │  Double-click  select a word and copy it (a triple click a line)           │"
style 21 23 37 reverse
text 22 "                     │  Click         open a worker's line, a row of the agent list, a count of   │"
style 22 23 30 reverse
text 23 "                     │                calls, a quiet row of calls, a command's whole output at    │"
text 24 "                     │                its \"more lines\", or an agent's thinking at its first line  │"
text 25 "                     │                                                                            │"
text 26 "                     │ Commands                                                                   │"
style 26 23 31 fg=cyan bold
text 27 "                     │ /new          start a new conversation (/resume goes back to the old one). │"
style 27 23 37 bold
text 28 "                     │               /new continue starts it from a brief of this one and the     │"
text 29 "                     │               agent's report  [continue]                                   │"
style 29 51 63 dim
text 30 "                     │ /resume       go back to an earlier conversation of this session, from a   │"
style 30 23 37 bold
text 31 "                     │               list or by its number  [NUMBER]                              │"
style 31 58 68 dim
text 32 "                     │ /cost         what this session has cost                                   │"
style 32 23 37 bold
text 33 "                     │                                                                            │"
text 34 "                     └───────────────────────────────────────────────── Esc  close   ↑ ↓  scroll ─┘"
style 34 71 76 reverse
style 34 76 82 dim
style 34 84 89 reverse
style 34 89 96 dim
text 35 "────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────"
style 35 0 120 dim
text 36 " last turn 34s"
style 36 1 14 dim
text 37 "────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────"
style 37 0 120 dim
text 38 " › Message  / for commands"
style 38 1 3 fg=cyan
style 38 3 26 dim
text 39 "────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────"
style 39 0 120 dim
