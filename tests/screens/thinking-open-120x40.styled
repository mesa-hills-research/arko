style 14 4 62 fg=#9d9d9d bg=#131313
style 14 62 120 fg=#dedede bg=#131313
text 15 "    The loop stops at the first newline, so the blank line never counts."
style 15 0 4 fg=#dedede bg=#131313
style 15 4 72 fg=#9d9d9d bg=#131313
style 15 72 120 fg=#dedede bg=#131313
text 16 ""
style 16 0 120 fg=#dedede bg=#131313
