text 27 "   /new                   start a new conversation (/resume goes back to the old one). /new continue starts it from a"
style 27 0 120 fg=#f2f9ff bg=#006ee5
text 28 "   /resume                go back to an earlier conversation of this session, from a list or by its number"
style 28 0 3 fg=#dedede bg=#101010
style 28 3 24 fg=#dedede bg=#101010 bold
style 28 24 120 fg=#dedede bg=#101010
text 29 "   /cost                  what this session has cost"
style 29 0 3 fg=#dedede bg=#101010
style 29 3 24 fg=#dedede bg=#101010 bold
style 29 24 120 fg=#dedede bg=#101010
text 30 "   /workers               what each worker is doing, or reported"
style 30 0 3 fg=#dedede bg=#101010
style 30 3 24 fg=#dedede bg=#101010 bold
style 30 24 120 fg=#dedede bg=#101010
text 31 "   /stop-workers          stop the workers running, or one of them (the agent can resume them)"
style 31 0 3 fg=#dedede bg=#101010
style 31 3 24 fg=#dedede bg=#101010 bold
style 31 24 120 fg=#dedede bg=#101010
text 32 "   /watch                 follow one worker's own work, or the main agent's again"
style 32 0 3 fg=#dedede bg=#101010
style 32 3 24 fg=#dedede bg=#101010 bold
style 32 24 120 fg=#dedede bg=#101010
text 33 "   /message               send a worker a message directly, which it reads at its next step or goes on with if it"
style 33 0 3 fg=#dedede bg=#101010
style 33 3 24 fg=#dedede bg=#101010 bold
style 33 24 120 fg=#dedede bg=#101010
text 34 "   /view                  how much of the work the transcript shows"
style 34 0 3 fg=#dedede bg=#101010
style 34 3 24 fg=#dedede bg=#101010 bold
style 34 24 120 fg=#dedede bg=#101010
