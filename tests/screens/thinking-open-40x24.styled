text 3 "▎ Why does the last test fail?"
style 3 0 2 fg=#419cff bg=#202020
style 3 2 40 fg=#dedede bg=#202020
text 4 ""
style 4 0 40 fg=#dedede bg=#131313
text 5 "  ▾ Thought"
style 5 0 4 fg=#9d9d9d bg=#131313
style 5 4 11 fg=#9d9d9d bg=#131313 bold
style 5 11 40 fg=#dedede bg=#131313
text 6 "    Reading the failure"
style 6 0 4 fg=#dedede bg=#131313
style 6 4 23 fg=#9d9d9d bg=#131313 bold
style 6 23 40 fg=#dedede bg=#131313
text 7 "    The last test expects a blank line"
style 7 0 4 fg=#dedede bg=#131313
style 7 4 38 fg=#9d9d9d bg=#131313
style 7 38 40 fg=#dedede bg=#131313
text 8 "    at the end of the file."
style 8 0 4 fg=#dedede bg=#131313
style 8 4 27 fg=#9d9d9d bg=#131313
style 8 27 40 fg=#dedede bg=#131313
text 9 "    The loop stops at the first newline,"
style 9 0 4 fg=#dedede bg=#131313
style 9 4 40 fg=#9d9d9d bg=#131313
text 10 "    so the blank line never counts."
style 10 0 4 fg=#dedede bg=#131313
style 10 4 35 fg=#9d9d9d bg=#131313
style 10 35 40 fg=#dedede bg=#131313
text 11 ""
style 11 0 40 fg=#dedede bg=#131313
text 12 "    The fix is in the loop's condition."
style 12 0 4 fg=#dedede bg=#131313
style 12 4 39 fg=#9d9d9d bg=#131313
style 12 39 40 fg=#dedede bg=#131313
text 13 ""
style 13 0 40 fg=#dedede bg=#131313
text 14 "  The loop in parse stops at the first"
style 14 0 14 fg=#dedede bg=#131313
style 14 14 19 fg=#dedede bg=#232323
style 14 19 40 fg=#dedede bg=#131313
text 15 "  newline, so the blank line at the end"
style 15 0 40 fg=#dedede bg=#131313
text 16 "  is lost."
style 16 0 40 fg=#dedede bg=#131313
text 17 ""
style 17 0 40 fg=#dedede bg=#131313
text 18 "  I can change the loop if you like."
style 18 0 40 fg=#dedede bg=#131313
