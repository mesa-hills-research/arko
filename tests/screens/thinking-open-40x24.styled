text 5 ""
style 5 0 40 fg=#dedede bg=#131313
text 6 "  Reading the failure"
style 6 0 2 fg=#dedede bg=#131313
style 6 2 21 fg=#9d9d9d bg=#131313 bold italic
style 6 21 40 fg=#dedede bg=#131313
text 7 "  The last test expects a blank line at"
style 7 0 2 fg=#dedede bg=#131313
style 7 2 39 fg=#9d9d9d bg=#131313 italic
style 7 39 40 fg=#dedede bg=#131313
text 8 "  the end of the file."
style 8 0 2 fg=#dedede bg=#131313
style 8 2 22 fg=#9d9d9d bg=#131313 italic
style 8 22 40 fg=#dedede bg=#131313
text 9 "  The loop stops at the first newline,"
style 9 0 2 fg=#dedede bg=#131313
style 9 2 38 fg=#9d9d9d bg=#131313 italic
style 9 38 40 fg=#dedede bg=#131313
text 10 "  so the blank line never counts."
style 10 0 2 fg=#dedede bg=#131313
style 10 2 33 fg=#9d9d9d bg=#131313 italic
style 10 33 40 fg=#dedede bg=#131313
text 11 ""
style 11 0 40 fg=#dedede bg=#131313
text 12 "  The fix is in the loop's condition."
style 12 0 2 fg=#dedede bg=#131313
style 12 2 37 fg=#9d9d9d bg=#131313 italic
style 12 37 40 fg=#dedede bg=#131313
text 13 ""
style 13 0 40 fg=#dedede bg=#131313
text 14 "  The loop in parse stops at the first"
style 14 0 14 fg=#dedede bg=#131313
style 14 14 19 fg=#dedede bg=#232323
style 14 19 40 fg=#dedede bg=#131313
text 15 "  newline, so the blank line at the end"
style 15 0 40 fg=#dedede bg=#131313
text 16 "  is lost."
style 16 0 40 fg=#dedede bg=#131313
text 17 ""
style 17 0 40 fg=#dedede bg=#131313
text 18 "  I can change the loop if you like."
