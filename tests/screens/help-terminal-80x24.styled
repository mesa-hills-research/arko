size 80 24
cursor 0 0 hidden
text 0 " ┌ Help ──────────────────────────────────────────────────────────────────────┐"
style 0 2 8 bold
text 1 " │                                                                            │"
text 2 " │ Keys                                                                       │"
style 2 3 7 fg=cyan bold
text 3 " │  Enter         send (a note while the agent works, else a new turn)        │"
style 3 3 10 reverse
text 4 " │  Shift+Enter   new line, where the terminal tells it from Enter            │"
style 4 3 16 reverse
text 5 " │  Ctrl+J        new line, in every terminal (Alt+Enter too where Alt works) │"
style 5 3 11 reverse
text 6 " │  ↑ ↓           earlier messages from the first or last line, then ↓ goes   │"
style 6 3 8 reverse
text 7 " │                to the agent list                                           │"
text 8 " │  Tab           complete a command in the menu, or its argument (↑ ↓ show   │"
style 8 3 8 reverse
text 9 " │                the others, → takes the one shown), else go to the agent    │"
text 10 "▎│                list                                                        │"
style 10 0 1 fg=cyan
text 11 " │  Ctrl+A E B F  line start, end, back, forward (readline)                   │"
style 11 3 17 reverse
text 12 " │  Ctrl+K U W Y  cut to the end, to the start or a word back, and paste the  │"
style 12 3 17 reverse
text 13 " │                cut                                                         │"
text 14 " │  PgUp PgDn     scroll the transcript (the wheel and Shift+↑ ↓ too)         │"
style 14 3 14 reverse
text 15 " │  End           back to the bottom, when the box is empty (Ctrl+End always) │"
style 15 3 8 reverse
text 16 " │  Ctrl+B        move the agent's running call to the background, else back  │"
style 16 3 11 reverse
text 17 " │                                                                            │"
text 18 " └───────────────────────────────────────────────── Esc  close   ↑ ↓  scroll ─┘"
style 18 51 56 reverse
style 18 56 62 dim
style 18 64 69 reverse
style 18 69 76 dim
text 19 "────────────────────────────────────────────────────────────────────────────────"
style 19 0 80 dim
text 20 " last turn 34s"
style 20 1 14 dim
text 21 "────────────────────────────────────────────────────────────────────────────────"
style 21 0 80 dim
text 22 " › Message  / for commands"
style 22 1 3 fg=cyan
style 22 3 26 dim
text 23 "────────────────────────────────────────────────────────────────────────────────"
style 23 0 80 dim
